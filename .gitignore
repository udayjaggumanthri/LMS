# ==============================================================================
# Prajnadhara EDU - Fullstack LMS Repository .gitignore
# ==============================================================================

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django Databases & Media
/backend/staticfiles/
# Allow pre-seeded sqlite database and media assets to be tracked
!/backend/db.sqlite3
# Allow uploaded brand assets and logos to be tracked
!/backend/media/
!/backend/media/uploads/
!/backend/media/uploads/**

# Node & Frontend
node_modules/
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Secrets
.env
.env.local
.env.*.local
/backend/.env
/frontend/.env

# Playwright & Testing
test-results/
playwright-report/
blob-report/
playwright/.cache/
/backend/test_screenshots/
/backend/scratch_*.py
/backend/test_*.py
/backend/test_*.html

# System Generated Logs
*.log
.system_generated/
