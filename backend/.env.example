# Django Production Environment Configuration
DEBUG=False
SECRET_KEY=your-production-django-secret-key-change-this-in-prod-2026
ALLOWED_HOSTS=localhost,127.0.0.1,api.prajnadharaedu.com,prajnadharaedu.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://prajnadharaedu.com,https://www.prajnadharaedu.com

# Database Configuration (PostgreSQL in production; automatically falls back to SQLite for local dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/lms

# Payment Gateway Configuration
# Optional ToucanPay Initial Provisioning (can be configured directly in Admin Console)
# Credentials are automatically encrypted with AES-128 (Fernet) in the database
TOUCANPAY_MID=your_merchant_id_here
TOUCANPAY_TID=your_terminal_id_here
TOUCANPAY_LOGIN_ID=your_login_id_here
TOUCANPAY_MAC_TOKEN=your_rsa256_jwt_token_here
TOUCANPAY_PASSWORD=your_merchant_portal_password_here

# Optional dedicated encryption key (if omitted, derived from SECRET_KEY)
FIELD_ENCRYPTION_KEY=optional_dedicated_encryption_key_here

# Optional Mail SMTP Server Configuration (can also be managed via Admin Center)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=support@prajnadharaedu.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Prajnadhara EDU <support@prajnadharaedu.com>
